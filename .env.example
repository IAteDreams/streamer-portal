# Copy to .env.local and fill in, or run `vercel env pull .env.development.local`
# if this project is linked. All .env* files except this one are gitignored.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Supabase Postgres via the Vercel integration) ---
# Pooled connection (pgBouncer, port 6543). The app uses this.
POSTGRES_URL=
# Direct connection (port 5432). Migrations need this - pgBouncer's
# transaction mode cannot run DDL.
POSTGRES_URL_NON_POOLING=
# Fallback if your provider names it differently.
# DATABASE_URL=

# --- Stripe Connect (optional) ---
# Without these the app uses the mock payout provider and moves no money.
#
# Prefer a RESTRICTED key (rk_...) over a secret key (sk_...): grant only
# "Transfers: write" and "Connected accounts: read". A leaked restricted key
# can do far less damage. https://docs.stripe.com/keys/restricted-api-keys
#
# No Stripe account? `npm i -g @stripe/cli && stripe sandbox create` issues
# working test keys without registering.
#
# NEVER commit a real key. Anything matching sk_live_* or rk_live_* is a live
# key. On Vercel, mark these as Sensitive environment variables.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Connected account created with Accounts v2, configuration.recipient,
# capability stripe_balance.stripe_transfers, dashboard: "express".
STRIPE_CONNECT_ACCOUNT_ID=

# --- Streaming platform integration (not wired up yet) ---
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
